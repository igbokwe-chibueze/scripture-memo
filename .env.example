# Local development must use a local database by default. This prevents page
# refreshes, test runs, seed commands, and hot reloads from consuming hosted
# Prisma Postgres operations. `npx prisma dev` prints the active local URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Keep automated tests isolated from both local development and production.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/scripture_memo_test?sslmode=disable"

# Integration suites fail closed unless this acknowledgement is present. The
# test database must still be separate from DATABASE_URL.
TEST_DATABASE_CONFIRMATION="scripture-memo-integration-tests"

# Better Auth requires an application URL and a strong secret. Never copy the
# placeholder secret into a deployed environment.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-local-secret"

# Public application URL used by generated links and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
