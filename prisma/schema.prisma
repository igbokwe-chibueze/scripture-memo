// Scripture Memo's relational source of truth.
//
// The schema keeps authentication-provider tables alongside product tables so
// Prisma can enforce every ownership relation and transaction boundary. Product
// services must still access these models through feature repositories.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TranslationCode {
  NIV
  ESV
  KJV
  WEB
  BSB
}

enum VerseStudySectionType {
  BOOK_BACKGROUND
  HISTORICAL_CONTEXT
  STUDY_NOTE
  KEY_LESSON
  APPLICATION
  CROSS_REFERENCES
  WORD_STUDY
  PRAYER
}

enum WaypointStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COOLDOWN
  COMPLETED
}

enum JourneyStage {
  LEARN
  RECALL
  STRENGTHEN
  MASTER
}

enum DayLevel {
  GLIMMER
  GLOW
  RADIANCE
}

enum GameMode {
  DRAG_DROP
  PUZZLE
  SWAP
  CUE
  FILL
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum GameModeAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum BadgeCategory {
  LEARNING
  STREAK
  MASTERY
  INDEPENDENCE
  SPEED
  EXPLORATION
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum RewardEventType {
  DAY_COMPLETE
  BADGE_UNLOCK
  MANUAL_ADMIN_AWARD
  SHOP_PURCHASE
}

enum FellowshipJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FellowshipJoinRequestSource {
  DIRECTORY
  INVITE
}

enum FellowshipLeadershipTransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum FellowshipDissolutionStatus {
  SCHEDULED
  CANCELLED
  FORCED
}

enum FellowshipSuspensionStatus {
  ACTIVE
  RESTORED
}

enum FellowshipSuspensionAppealStatus {
  PENDING
  RESTORED
  UPHELD
}

enum FellowshipGovernanceCaseKind {
  TRANSFER
  SUSPENSION
  CLOSURE
}

enum BeaconLeague {
  TRAVELER
  DISCIPLE
  MESSENGER
  WATCHMAN
  TEACHER
  SHEPHERD
  ELDER
  SCRIBE
  SAINT
}

// Notifications store stable event meaning instead of translated prose so the
// same record can render correctly after a learner changes language.
enum UserNotificationType {
  BADGE_AWARDED
  LEAGUE_PROMOTED
  LEAGUE_DEMOTED
  LEAGUE_STAYED
  FELLOWSHIP_INVITE
  FELLOWSHIP_REQUEST
  FELLOWSHIP_LEADERSHIP
  FELLOWSHIP_CLOSING
  FELLOWSHIP_SUSPENSION
  FELLOWSHIP_APPEAL
  COOLDOWN_READY
  STREAK_RISK
  SYSTEM
}

// Better Auth owns identity and credential lifecycle fields on this table.
// Product state is kept in one-to-one profile/settings/streak records, while
// authorization and suspension fields remain here for efficient server checks.
model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  role           UserRole  @default(USER)
  banned         Boolean   @default(false)
  banReason      String?
  banExpires     DateTime?
  suspendedAt    DateTime?
  suspendReason  String?
  suspendedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions                   Session[]
  accounts                   Account[]
  profile                    UserProfile?
  settings                   UserSettings?
  waypointProgress           UserWaypointProgress[]
  dayProgress                UserDayProgress[]
  gameSessions               GameSession[]
  gameModeAttempts           GameModeAttempt[]
  hintUsages                 HintUsage[]
  rewardLedgerEntries        RewardLedger[]
  streak                     UserStreak?
  badgeProgress              UserBadgeProgress[]
  fellowshipMemberships      FellowshipMember[]
  fellowshipJoinRequests     FellowshipJoinRequest[]        @relation("FellowshipJoinRequester")
  fellowshipRequestsReviewed FellowshipJoinRequest[]        @relation("FellowshipJoinReviewer")
  fellowshipTransfersFrom    FellowshipLeadershipTransfer[] @relation("FellowshipTransferFrom")
  fellowshipTransfersTo      FellowshipLeadershipTransfer[] @relation("FellowshipTransferTarget")
  fellowshipDissolutions     FellowshipDissolution[]        @relation("FellowshipDissolutionInitiator")
  fellowshipSuspensionsMade  FellowshipSuspension[]         @relation("FellowshipSuspensionActor")
  fellowshipSuspensionsEnded FellowshipSuspension[]         @relation("FellowshipSuspensionRestorer")
  fellowshipAppealsMade      FellowshipSuspensionAppeal[]   @relation("FellowshipSuspensionAppellant")
  fellowshipAppealsReviewed  FellowshipSuspensionAppeal[]   @relation("FellowshipSuspensionReviewer")
  fellowshipsCreated         Fellowship[]                   @relation("FellowshipCreator")
  shopPurchases              UserShopPurchase[]
  verseNotes                 UserVerseNote[]
  favoriteVerses             UserFavoriteVerse[]
  versesCreated              Verse[]                        @relation("VerseCreator")
  badgesCreated              Badge[]                        @relation("BadgeCreator")
  shopItemsCreated           ShopItem[]                     @relation("ShopItemCreator")
  auditLogs                  AuditLog[]                     @relation("AuditActor")
  fellowshipCasesOpened      FellowshipGovernanceCase[]     @relation("FellowshipGovernanceCaseOpener")
  beaconXpEntries            BeaconXpLedger[]
  beaconWeeklyScores         BeaconWeeklyScore[]
  beaconLeagueMemberships    BeaconLeagueMembership[]
  notifications              UserNotification[]

  @@index([role])
  @@index([suspendedAt])
  @@map("user")
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  displayName             String
  countryCode             String?
  totalGlowPoints         Int       @default(0)
  totalWaypointsCompleted Int       @default(0)
  totalHintsUsed          Int       @default(0)
  startingHintAllowance   Int       @default(5)
  beaconXp                Int       @default(0)
  beaconLevel             Int       @default(1)
  beaconCrowns            Int       @default(0)
  avatarKey               String    @default("lion")
  avatarFrameKey          String    @default("default")
  isPartner               Boolean   @default(false)
  lastSeenAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalWaypointsCompleted(sort: Desc), totalGlowPoints(sort: Desc)])
  @@index([totalGlowPoints(sort: Desc)])
  @@index([countryCode, totalWaypointsCompleted(sort: Desc), totalGlowPoints(sort: Desc)])
  @@index([beaconLevel(sort: Desc), beaconXp(sort: Desc)])
  @@index([lastSeenAt])
}

model UserSettings {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  preferredTranslation   TranslationCode @default(KJV)
  hasSelectedTranslation Boolean         @default(false)
  audioEnabled           Boolean         @default(true)
  reducedMotion          Boolean         @default(false)
  theme                  String          @default("system")
  locale                 String          @default("en")
  timeZone               String          @default("UTC")
  hasConfiguredTimeZone  Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verse {
  id             String              @id @default(cuid())
  reference      String              @unique
  book           String
  chapter        Int
  verseStart     Int
  verseEnd       Int?
  reflection     String?
  studyNote      String?
  isActive       Boolean             @default(false)
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User?               @relation("VerseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  translations   VerseTranslation[]
  studySections  VerseStudySection[]
  tags           VerseTag[]
  packs          PackVerse[]
  waypoints      Waypoint[]
  replaySessions GameSession[]
  notes          UserVerseNote[]
  favorites      UserFavoriteVerse[]

  @@index([book, chapter, verseStart])
  @@index([isActive])
}

model VerseStudySection {
  id        String                @id @default(cuid())
  verseId   String
  type      VerseStudySectionType
  position  Int
  content   String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  verse     Verse                 @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([verseId, type])
  @@index([verseId, position])
}

model VerseTranslation {
  id             String          @id @default(cuid())
  verseId        String
  translation    TranslationCode
  text           String
  normalizedText String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  verse          Verse           @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([verseId, translation])
  @@index([translation])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  verses    VerseTag[]
}

model VerseTag {
  verseId   String
  tagId     String
  createdAt DateTime @default(now())
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([verseId, tagId])
  @@index([tagId])
}

model Pack {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  verses      PackVerse[]

  @@index([isActive])
}

model PackVerse {
  packId    String
  verseId   String
  position  Int
  createdAt DateTime @default(now())
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Restrict)

  @@id([packId, verseId])
  @@unique([packId, position])
  @@index([verseId])
}

model Waypoint {
  /// Learn, Recall, and Strengthen are unique per assigned verse through the
  /// partial PostgreSQL index added by migration; Master may repeat.
  id           String                 @id @default(cuid())
  number       Int                    @unique
  verseId      String?
  journeyStage JourneyStage
  isActive     Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  verse        Verse?                 @relation(fields: [verseId], references: [id], onDelete: Restrict)
  userProgress UserWaypointProgress[]
  dayProgress  UserDayProgress[]
  gameSessions GameSession[]

  @@index([verseId, journeyStage])
  @@index([isActive, number])
}

model UserWaypointProgress {
  id          String         @id @default(cuid())
  userId      String
  waypointId  String
  status      WaypointStatus @default(LOCKED)
  unlockedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  waypoint    Waypoint       @relation(fields: [waypointId], references: [id], onDelete: Restrict)

  @@unique([userId, waypointId])
  @@index([userId, status])
  @@index([waypointId])
}

model UserDayProgress {
  id                String           @id @default(cuid())
  userId            String
  waypointId        String
  dayLevel          DayLevel
  status            CompletionStatus @default(NOT_STARTED)
  unlocksAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  glowPointsAwarded Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  waypoint          Waypoint         @relation(fields: [waypointId], references: [id], onDelete: Restrict)
  gameSessions      GameSession[]

  // This is the database-level defense against duplicate day rewards.
  @@unique([userId, waypointId, dayLevel])
  @@index([userId, waypointId])
  @@index([userId, status, unlocksAt])
  @@index([waypointId])
}

model GameSession {
  id            String            @id @default(cuid())
  userId        String
  waypointId    String?
  verseId       String
  dayProgressId String?
  dayLevel      DayLevel?
  translation   TranslationCode   @default(KJV)
  status        CompletionStatus  @default(IN_PROGRESS)
  isVaultReplay Boolean           @default(false)
  isAdminTest   Boolean           @default(false)
  adminTestMode GameMode?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  waypoint      Waypoint?         @relation(fields: [waypointId], references: [id], onDelete: Restrict)
  verse         Verse             @relation(fields: [verseId], references: [id], onDelete: Restrict)
  dayProgress   UserDayProgress?  @relation(fields: [dayProgressId], references: [id], onDelete: Restrict)
  attempts      GameModeAttempt[]
  hintUsages    HintUsage[]

  @@index([userId, status])
  @@index([userId, isVaultReplay, createdAt(sort: Desc)])
  @@index([userId, isAdminTest, createdAt(sort: Desc)])
  @@index([waypointId, dayLevel])
  @@index([dayProgressId])
}

model GameModeAttempt {
  id            String                @id @default(cuid())
  gameSessionId String
  userId        String
  gameMode      GameMode
  attemptNumber Int                   @default(1)
  status        GameModeAttemptStatus @default(IN_PROGRESS)
  score         Int?
  durationMs    Int?
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  gameSession   GameSession           @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, gameMode, attemptNumber])
  @@index([userId, gameMode, status])
}

model HintUsage {
  id            String      @id @default(cuid())
  userId        String
  gameSessionId String
  gameMode      GameMode
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameSessionId, gameMode])
}

// Ledger rows deliberately have no updatedAt field. Application repositories
// expose inserts and reads only; corrections are represented by compensating rows.
model RewardLedger {
  id             String          @id @default(cuid())
  userId         String
  amount         Int
  eventType      RewardEventType
  reason         String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt])
}

// Beacon XP is permanent progression, not spendable currency. Every entry is
// immutable and idempotent so lifetime XP and weekly competition can be audited.
model BeaconXpLedger {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  reason         String
  idempotencyKey String   @unique
  earnedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, earnedAt(sort: Desc)])
}

model BeaconWeek {
  id          String                   @id @default(cuid())
  startsAt    DateTime                 @unique
  endsAt      DateTime                 @unique
  createdAt   DateTime                 @default(now())
  scores      BeaconWeeklyScore[]
  cohorts     BeaconLeagueCohort[]
  memberships BeaconLeagueMembership[]
}

model BeaconWeeklyScore {
  id                 String     @id @default(cuid())
  weekId             String
  userId             String
  points             Int        @default(0)
  modesCompleted     Int        @default(0)
  waypointsCompleted Int        @default(0)
  lastScoredAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  week               BeaconWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId])
  @@index([weekId, points(sort: Desc), waypointsCompleted(sort: Desc), lastScoredAt])
}

model BeaconLeagueCohort {
  id          String                   @id @default(cuid())
  weekId      String
  league      BeaconLeague
  groupNumber Int
  createdAt   DateTime                 @default(now())
  week        BeaconWeek               @relation(fields: [weekId], references: [id], onDelete: Cascade)
  memberships BeaconLeagueMembership[]

  @@unique([weekId, league, groupNumber])
  @@index([weekId, league])
}

model BeaconLeagueMembership {
  id             String             @id @default(cuid())
  weekId         String
  cohortId       String
  userId         String
  league         BeaconLeague
  previousLeague BeaconLeague?
  finalRank      Int?
  crownAward     Int                @default(0)
  createdAt      DateTime           @default(now())
  week           BeaconWeek         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  cohort         BeaconLeagueCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId])
  @@index([cohortId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model UserNotification {
  id          String               @id @default(cuid())
  userId      String
  type        UserNotificationType
  dedupeKey   String               @unique
  payload     Json
  readAt      DateTime?
  presentedAt DateTime?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WHY: The shell reads only one learner's newest notifications. This index
  // keeps that bounded query cheap as the notification history grows.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak(sort: Desc)])
}

model Badge {
  id           String              @id @default(cuid())
  name         String              @unique
  slug         String              @unique
  description  String
  icon         String?
  category     BadgeCategory
  rarity       BadgeRarity
  criteriaKey  String
  targetValue  Int
  rewardAmount Int                 @default(0)
  isHidden     Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    User?               @relation("BadgeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  userProgress UserBadgeProgress[]

  @@index([category, isActive])
  @@index([criteriaKey, isActive])
}

model UserBadgeProgress {
  id         String           @id @default(cuid())
  userId     String
  badgeId    String
  progress   Int              @default(0)
  status     CompletionStatus @default(NOT_STARTED)
  unlockedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge            @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([userId, badgeId])
  @@index([userId, status])
  @@index([badgeId, status])
}

model Fellowship {
  id                  String                         @id @default(cuid())
  name                String
  slug                String                         @unique
  description         String?
  isPublic            Boolean                        @default(true)
  insigniaKey         String                         @default("word-star")
  inviteCode          String                         @unique
  createdById         String
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  createdBy           User                           @relation("FellowshipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members             FellowshipMember[]
  joinRequests        FellowshipJoinRequest[]
  leadershipTransfers FellowshipLeadershipTransfer[]
  dissolutions        FellowshipDissolution[]
  suspensions         FellowshipSuspension[]
  governanceCases     FellowshipGovernanceCase[]

  @@index([isPublic, name])
  @@index([createdById])
}

model FellowshipJoinRequest {
  id           String                      @id @default(cuid())
  fellowshipId String
  userId       String
  source       FellowshipJoinRequestSource
  status       FellowshipJoinRequestStatus @default(PENDING)
  requestedAt  DateTime                    @default(now())
  resolvedAt   DateTime?
  reviewedById String?
  fellowship   Fellowship                  @relation(fields: [fellowshipId], references: [id], onDelete: Cascade)
  user         User                        @relation("FellowshipJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                       @relation("FellowshipJoinReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // WHY: One durable row per learner and fellowship prevents duplicate pending
  // requests while retaining the latest approval, rejection, or cancellation.
  @@unique([fellowshipId, userId])
  @@index([fellowshipId, status, requestedAt])
  @@index([userId, status, requestedAt])
  @@index([reviewedById])
}

model FellowshipMember {
  id           String     @id @default(cuid())
  fellowshipId String
  userId       String
  joinedAt     DateTime   @default(now())
  fellowship   Fellowship @relation(fields: [fellowshipId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fellowshipId, userId])
  @@index([userId, fellowshipId])
  @@index([fellowshipId, joinedAt])
}

/// Records each ownership proposal or emergency transfer without deleting member history.
model FellowshipLeadershipTransfer {
  id               String                             @id @default(cuid())
  fellowshipId     String
  fromLeaderId     String
  targetUserId     String
  status           FellowshipLeadershipTransferStatus @default(PENDING)
  requestedAt      DateTime                           @default(now())
  resolvedAt       DateTime?
  governanceCaseId String                             @unique
  fellowship       Fellowship                         @relation(fields: [fellowshipId], references: [id], onDelete: Restrict)
  fromLeader       User                               @relation("FellowshipTransferFrom", fields: [fromLeaderId], references: [id], onDelete: Restrict)
  targetUser       User                               @relation("FellowshipTransferTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  governanceCase   FellowshipGovernanceCase           @relation(fields: [governanceCaseId], references: [id], onDelete: Restrict)

  @@index([fellowshipId, status, requestedAt(sort: Desc)])
  @@index([targetUserId, status, requestedAt(sort: Desc)])
}

/// Stores reversible leader closure or an immediate audited Super Admin closure.
model FellowshipDissolution {
  id                   String                      @id @default(cuid())
  fellowshipId         String
  initiatedById        String
  reason               String
  status               FellowshipDissolutionStatus @default(SCHEDULED)
  createdAt            DateTime                    @default(now())
  cancellationDeadline DateTime?
  cancelledAt          DateTime?
  governanceCaseId     String                      @unique
  fellowship           Fellowship                  @relation(fields: [fellowshipId], references: [id], onDelete: Restrict)
  initiatedBy          User                        @relation("FellowshipDissolutionInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  governanceCase       FellowshipGovernanceCase    @relation(fields: [governanceCaseId], references: [id], onDelete: Restrict)

  @@index([fellowshipId, status, createdAt(sort: Desc)])
}

/// Stores reversible platform enforcement without deleting Fellowship history.
model FellowshipSuspension {
  id                String                      @id @default(cuid())
  fellowshipId      String
  suspendedById     String
  reason            String
  status            FellowshipSuspensionStatus  @default(ACTIVE)
  createdAt         DateTime                    @default(now())
  appealDeadline    DateTime
  restoredAt        DateTime?
  restoredById      String?
  restorationReason String?
  governanceCaseId  String                      @unique
  fellowship        Fellowship                  @relation(fields: [fellowshipId], references: [id], onDelete: Restrict)
  suspendedBy       User                        @relation("FellowshipSuspensionActor", fields: [suspendedById], references: [id], onDelete: Restrict)
  restoredBy        User?                       @relation("FellowshipSuspensionRestorer", fields: [restoredById], references: [id], onDelete: Restrict)
  appeal            FellowshipSuspensionAppeal?
  governanceCase    FellowshipGovernanceCase    @relation(fields: [governanceCaseId], references: [id], onDelete: Restrict)

  @@index([fellowshipId, status, createdAt(sort: Desc)])
  @@index([suspendedById, createdAt(sort: Desc)])
}

/// Gives each material governance action a stable number and searchable case history.
model FellowshipGovernanceCase {
  id            String                        @id @default(cuid())
  caseSequence  Int                           @unique @default(autoincrement())
  caseNumber    String                        @unique
  kind          FellowshipGovernanceCaseKind
  currentStatus String
  fellowshipId  String
  openedById    String
  openedAt      DateTime                      @default(now())
  fellowship    Fellowship                    @relation(fields: [fellowshipId], references: [id], onDelete: Restrict)
  openedBy      User                          @relation("FellowshipGovernanceCaseOpener", fields: [openedById], references: [id], onDelete: Restrict)
  transfer      FellowshipLeadershipTransfer?
  dissolution   FellowshipDissolution?
  suspension    FellowshipSuspension?
  auditLogs     AuditLog[]

  @@index([kind, openedAt(sort: Desc)])
  @@index([currentStatus, openedAt(sort: Desc)])
  @@index([fellowshipId, openedAt(sort: Desc)])
}

/// Allows one leader appeal per suspension and keeps its independent decision.
model FellowshipSuspensionAppeal {
  id             String                           @id @default(cuid())
  suspensionId   String                           @unique
  appellantId    String
  statement      String
  status         FellowshipSuspensionAppealStatus @default(PENDING)
  submittedAt    DateTime                         @default(now())
  reviewedAt     DateTime?
  reviewerId     String?
  decisionReason String?
  suspension     FellowshipSuspension             @relation(fields: [suspensionId], references: [id], onDelete: Restrict)
  appellant      User                             @relation("FellowshipSuspensionAppellant", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewer       User?                            @relation("FellowshipSuspensionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt(sort: Desc)])
  @@index([appellantId, submittedAt(sort: Desc)])
}

model ShopItem {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  description   String
  itemType      String
  grantQuantity Int                @default(0)
  cost          Int
  isActive      Boolean            @default(true)
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     User?              @relation("ShopItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  purchases     UserShopPurchase[]

  @@index([isActive, itemType])
}

model UserShopPurchase {
  id                  String   @id @default(cuid())
  userId              String
  shopItemId          String
  quantity            Int      @default(1)
  unitCost            Int
  totalCost           Int
  entitlementQuantity Int
  idempotencyKey      String   @unique
  purchasedAt         DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  shopItem            ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@index([userId, purchasedAt(sort: Desc)])
  @@index([shopItemId])
}

model UserVerseNote {
  id        String   @id @default(cuid())
  userId    String
  verseId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Restrict)

  @@unique([userId, verseId])
  @@index([verseId])
}

model UserFavoriteVerse {
  userId    String
  verseId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Restrict)

  @@id([userId, verseId])
  @@index([verseId])
}

model AuditLog {
  id               String                    @id @default(cuid())
  actorId          String?
  action           String
  entityType       String
  entityId         String?
  metadata         Json?
  ipAddress        String?
  createdAt        DateTime                  @default(now())
  governanceCaseId String?
  actor            User?                     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  governanceCase   FellowshipGovernanceCase? @relation(fields: [governanceCaseId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action, createdAt])
  @@index([governanceCaseId, createdAt(sort: Desc)])
}

// These four models must remain compatible with Better Auth's generated schema.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth uses this database-backed counter for requests made directly to
// its public API route. Server Actions add a separate application-level guard
// because Better Auth intentionally excludes internal auth.api calls.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// One row stores Super Admin-controlled defaults for future account setup and
// server-owned reward calculations. Product repositories own every query.
model PlatformSettings {
  id                          String          @id @default("global")
  defaultTranslation          TranslationCode @default(KJV)
  baseGlowPoints              Int             @default(100)
  defaultHintAllowance        Int             @default(5)
  adminCooldownTestingEnabled Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
}

/// Stores an explicit bundled-artwork choice for a one-based Map A trail.
/// Missing rows intentionally mean that the trail uses the repeating catalogue default.
model MapTrailArtwork {
  trailNumber Int      @id
  themeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mapTrailArtwork")
}
