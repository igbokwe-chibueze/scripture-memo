{
  "name": "scripture-memo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "bible-structure:generate": "node scripts/generate-bible-structure.mjs",
    "curriculum:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-curriculum-data.ps1",
    "local:curriculum:reset": "tsx scripts/reset-local-curriculum.ts",
    "local:curriculum:verify": "tsx scripts/verify-local-curriculum.ts",
    "local:fixtures": "tsx scripts/seed-local-fixtures.ts",
    "local:player": "tsx scripts/prepare-local-player.ts",
    "oil-shop:seed": "tsx scripts/seed-oil-shop.ts",
    "start": "next start",
    "auth:generate": "auth generate --config ./lib/auth/auth.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx scripts/run-unit-tests.ts",
    "test:design-system": "tsx --test scripts/design-system.test.ts",
    "test:errors": "tsx --test lib/errors/error-catalog.test.ts",
    "test:platform-settings": "tsx --test features/platform-settings/schemas/update-platform-settings.schema.test.ts",
    "test:audit-logs": "tsx --test features/audit-logs/lib/safe-audit-summary.test.ts",
    "test:database-guard": "tsx --test lib/testing/test-database-guard.test.ts",
    "test:database:reset": "tsx --conditions=react-server scripts/reset-integration-test-database.ts",
    "test:local-fixtures": "tsx --test features/dev-fixtures/lib/assert-local-database-url.test.ts",
    "test:progression": "tsx --test features/progression/lib/progression-utils.test.ts",
    "test:streaks": "tsx --test features/progression/lib/streak-utils.test.ts",
    "test:gameplay": "tsx --test features/gameplay/lib/gameplay-generators.test.ts features/gameplay/lib/drag-drop-state.test.ts features/gameplay/lib/puzzle-state.test.ts features/gameplay/lib/cue-state.test.ts features/gameplay/lib/fill-state.test.ts",
    "test:database:pool": "tsx --test lib/database/get-postgres-pool-config.test.ts",
    "test:rewards": "tsx --test features/rewards/lib/day-reward.test.ts",
    "test:rewards:integration": "tsx --conditions=react-server --test features/rewards/repositories/reward.repository.test.ts",
    "test:hints": "tsx --test features/hints/lib/hint-balance.test.ts",
    "test:badges": "tsx --test features/badges/data/badge-catalog.test.ts",
    "test:vault": "tsx --test features/vault/lib/vault-mastery.test.ts",
    "test:day-selection": "tsx --test features/waypoints/lib/day-selection.test.ts",
    "test:map": "tsx --test features/map/data/map-themes.test.ts features/map/lib/map-positioner.test.ts features/map/lib/map-utils.test.ts features/map/lib/map-variant.test.ts",
    "test:i18n": "tsx --test i18n/config.test.ts",
    "test:fellowships": "tsx --test features/fellowships/schemas/fellowship.schema.test.ts features/fellowships/schemas/fellowship-governance.schema.test.ts features/fellowships/schemas/fellowship-case-filters.schema.test.ts",
    "test:beacon": "tsx --test features/beacon/lib/beacon-progression.test.ts",
    "test:auth-rate-limit:integration": "tsx --conditions=react-server --test features/auth/repositories/auth.repository.test.ts",
    "test:account-suspension:integration": "tsx --conditions=react-server --test features/auth/lib/account-suspension.integration.test.ts",
    "test:gameplay-submission-limit:integration": "tsx --conditions=react-server --test features/gameplay/repositories/gameplay-submission-limit.repository.test.ts",
    "test:auth-delivery": "tsx --conditions=react-server --test features/auth/lib/email-verification-delivery.test.ts features/auth/lib/email-verification-token.test.ts features/auth/lib/resend-auth-email.test.ts",
    "test:integration": "tsx --conditions=react-server --test features/waypoints/repositories/waypoint.repository.test.ts",
    "test:progression:integration": "tsx --conditions=react-server --test features/progression/repositories/progression.repository.test.ts",
    "test:gameplay-concurrency:integration": "tsx --conditions=react-server --test features/gameplay/repositories/gameplay-completion-concurrency.repository.test.ts",
    "test:fellowship-governance-concurrency:integration": "tsx --conditions=react-server --test features/fellowships/repositories/fellowship-governance-concurrency.repository.test.ts",
    "test:concurrency:integration": "npm run test:auth-rate-limit:integration && npm run test:progression:integration && npm run test:gameplay-submission-limit:integration && npm run test:gameplay-concurrency:integration && npm run test:fellowship-governance-concurrency:integration",
    "test:concurrency:local": "tsx --conditions=react-server scripts/run-local-postgres-concurrency-tests.ts",
    "local:test:start": "tsx scripts/start-local-test-database.ts",
    "test:database:migrate": "tsx scripts/migrate-local-test-database.ts",
    "test:fellowships:integration": "tsx --conditions=react-server --test features/fellowships/repositories/fellowship.repository.test.ts",
    "test:integration:all": "npm run test:integration && npm run test:progression:integration && npm run test:rewards:integration && npm run test:fellowships:integration",
    "audit:ranking-plans": "tsx --conditions=react-server scripts/audit-local-ranking-plans.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.6",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bible-passage-reference-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "@prisma/dev": "0.24.17"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
